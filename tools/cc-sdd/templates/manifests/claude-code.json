{
  "version": 1,
  "artifacts": [
    {
      "id": "commands",
      "source": {
        "type": "templateDir",
        "fromDir": "templates/agents/{{AGENT}}/commands",
        "toDir": "{{AGENT_COMMANDS_DIR}}"
      },
      "when": {
        "agent": "claude-code"
      }
    },
    {
      "id": "doc_main",
      "source": {
        "type": "templateFile",
        "from": "templates/agents/{{AGENT}}/docs/CLAUDE.md",
        "toDir": ".",
        "rename": "{{AGENT_DOC}}"
      },
      "when": {
        "agent": "claude-code"
      }
    },
    {
      "id": "settings_common",
      "source": {
        "type": "templateDir",
        "fromDir": "templates/shared/settings",
        "toDir": "{{KIRO_DIR}}/settings"
      },
      "when": {
        "agent": "claude-code"
      }
    },
    {
      "id": "skills",
      "source": {
        "type": "templateDir",
        "fromDir": "templates/shared/skills",
        "toDir": "{{KIRO_DIR}}/skills"
      },
      "when": {
        "agent": "claude-code"
      }
    },
    {
      "id": "plugin_base",
      "source": {
        "type": "templateDir",
        "fromDir": "templates/agents/{{AGENT}}/plugin",
        "toDir": "{{KIRO_DIR}}/plugins/kiro-sdd"
      },
      "when": {
        "agent": "claude-code"
      }
    },
    {
      "id": "plugin_commands",
      "source": {
        "type": "templateDir",
        "fromDir": "templates/agents/{{AGENT}}/commands",
        "toDir": "{{KIRO_DIR}}/plugins/kiro-sdd/commands"
      },
      "when": {
        "agent": "claude-code"
      }
    },
    {
      "id": "plugin_skills",
      "source": {
        "type": "templateDir",
        "fromDir": "templates/shared/skills",
        "toDir": "{{KIRO_DIR}}/plugins/kiro-sdd/skills"
      },
      "when": {
        "agent": "claude-code"
      }
    },
    {
      "id": "plugin_marketplace",
      "source": {
        "type": "templateDir",
        "fromDir": "templates/agents/{{AGENT}}/marketplace",
        "toDir": "{{KIRO_DIR}}/marketplace"
      },
      "when": {
        "agent": "claude-code"
      }
    },
    {
      "id": "skills_root",
      "source": {
        "type": "templateDir",
        "fromDir": "templates/shared/skills",
        "toDir": "skills"
      },
      "when": {
        "agent": "claude-code"
      }
    }
  ]
}
